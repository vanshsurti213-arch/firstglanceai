# ==============================================================================
# FirstGlance AI - Environment Configuration Template
# ==============================================================================

# Core Service Configuration
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
SERVICE_NAME=firstglance-ai-gateway
LOG_LEVEL=info

# Model & Inference Acceleration Engine
FG_MODEL_NAME=firstglance-v2-core
FG_INFERENCE_BACKEND=simd-accelerated
FG_BATCH_TIMEOUT_MS=15
FG_MAX_CONCURRENT_INFERENCES=64
CUDA_VISIBLE_DEVICES=0

# Security & Model Decryption (Required for Production Deployments)
VAULT_ADDR=https://vault.internal.firstglance.ai:8200
VAULT_ROLE_ID=firstglance-vision-runtime
FG_MODEL_ENCRYPTION_KEY=arn:fg:kms:us-east-1:81928391:key/vision-weights-v2
API_KEY_SECRET=fg-dev-local-secret-key-32-chars-long!

# Storage & Telemetry Cache
REDIS_URL=redis://localhost:6379
TELEMETRY_SAMPLE_RATE=1.0
