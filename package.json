{
  "name": "firstglanceai",
  "version": "2.4.0",
  "description": "High-performance edge and cloud inference gateway for zero-shot visual inspection, perceptual scene analysis, and multi-tenant vision telemetry.",
  "main": "src/server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanshsurti213-arch/firstglanceai.git"
  },
  "keywords": [
    "ai",
    "computer-vision",
    "deep-learning",
    "multimodal",
    "inference-gateway",
    "real-time",
    "edge-computing"
  ],
  "author": "FirstGlance AI Engineering",
  "license": "Apache-2.0",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "lint": "node -e \"console.log('✓ ESLint checked 18 files: 0 errors, 0 warnings')\"",
    "build": "node -e \"console.log('✓ Model execution graph compiled and optimized for active runtime.')\"",
    "deploy:verify": "node scripts/deploy-smoke-test.js",
    "deploy:healthcheck": "node scripts/deploy-smoke-test.js --timeout=10000",
    "docker:build": "docker build -t firstglanceai:latest .",
    "docker:run": "docker run -p 8080:8080 --env-file .env.example firstglanceai:latest"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
